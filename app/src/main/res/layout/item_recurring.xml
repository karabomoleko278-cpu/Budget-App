<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="4dp"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgRecurring"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_receipt"
            android:background="?attr/colorSurfaceVariant"
            android:padding="8dp"
            app:shapeAppearanceOverlay="@style/CircleImage"
            app:tint="@color/vault_blue" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Recurring Title"
                android:textColor="?android:attr/textColorPrimary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Category"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/txtFrequencyAndDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Monthly • Next: 15 Jun"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="11sp"
                android:alpha="0.7" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/txtAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R 0.00"
                android:textColor="@color/vault_blue"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginEnd="8dp" />

            <ImageButton
                android:id="@+id/btnDelete"
                style="@style/Vault.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Delete"
                android:src="@android:drawable/ic_menu_delete"
                app:tint="@color/vault_red" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
