<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forest_green">

    <!-- Custom Top App Bar -->
    <LinearLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="20dp"
        android:gravity="center_vertical"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/ivory_cream" />

        <TextView
            android:id="@+id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Financial Analysis"
            android:textColor="@color/ivory_cream"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginStart="8dp" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/appBar"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Horizontal Tab Selector -->
            <com.google.android.material.tabs.TabLayout
                android:id="@+id/periodTabs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@android:color/transparent"
                app:tabIndicatorColor="@color/soft_gold"
                app:tabSelectedTextColor="@color/soft_gold"
                app:tabTextColor="@color/ivory_cream"
                app:tabRippleColor="@android:color/transparent"
                app:tabIndicatorHeight="4dp">
                <com.google.android.material.tabs.TabItem
                    android:id="@+id/tabDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Day" />
                <com.google.android.material.tabs.TabItem
                    android:id="@+id/tabWeek"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Week" />
                <com.google.android.material.tabs.TabItem
                    android:id="@+id/tabMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Month" />
            </com.google.android.material.tabs.TabLayout>

            <!-- Total spent with gold "outline" style -->
            <TextView
                android:id="@+id/totalSpentText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:gravity="center"
                android:text="TOTAL: R 0.00"
                android:textColor="@color/ivory_cream"
                android:textSize="36sp"
                android:textStyle="bold"
                android:shadowColor="@color/soft_gold"
                android:shadowDx="2"
                android:shadowDy="2"
                android:shadowRadius="1" />

            <!-- Analysis Dashboard Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PremiumCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:layout_marginBottom="32dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cumulative Spending"
                        android:textColor="@color/soft_gold"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/lineChart"
                        android:layout_width="match_parent"
                        android:layout_height="300dp"
                        android:layout_marginTop="16dp" />

                    <TextView
                        android:id="@+id/emptyStateText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:padding="32dp"
                        android:text="No data found for this period"
                        android:textColor="@color/ivory_cream"
                        android:visibility="gone" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
